# 外端Agent生产合作社 · 环境变量样例（由 agent_community/platform/env_spec.py 生成，勿手改）
# 用法：cp .env.example .env   然后按需修改；**密钥类不要提交进仓库**。
# 说明：下面给的都是**默认值**，照抄不会改变行为；想改哪项就改哪项。
#       全部都有默认值 —— 一个都不设也能跑（不配 AI 时走规则兜底）。

# ── 部署核心 ────────────────────────────────────────
# 运行模式：留空=开发；`production` 时对条件必需项更严格（缺了不让启动）
# 例如：production
AC_ENV=

# 平台监听端口（**端口因人而异**，命令行 `--port` 优先级更高）
AC_PORT=18920

# 平台监听地址。默认 0.0.0.0（容器/局域网可达）；只想本机访问填 127.0.0.1
# 例如：127.0.0.1
AC_HOST=0.0.0.0

# 运行数据目录（工作间/审计/记忆/桥产物都落这里）。**换目录不改代码**就靠它
# 例如：/var/lib/agent-community
AC_DATA_DIR=

# **心智根（根A）目录**：每个 agent 的永久记忆（宪章/记忆索引/memories/日志/死胡同）都在这。空＝默认 `<AC_DATA_DIR>/minds`。它**必须与工作区（根B）分开**——工作区可整根归档，记忆不能跟着丢
# 例如：/var/lib/ac-minds
AC_MIND_ROOT=

# 条件必需：对外暴露平台（AC_HOST 非回环）时
# 平台访问令牌（跨机/对外访问时必设；空=仅本机可用）
# 例如：sk-your-token
AC4_TOKEN=

# 外部访问只读档：=1 时**非本地**请求只放行查看类 GET，写操作一律 403（默认 0）
# 例如：1
AC_EXTERNAL_READONLY=0

# 关停口令（空=关停端点仅允许本机来源 + 二次确认）
# 例如：your-pin
AC4_SHUTDOWN_PIN=

# 启动器用哪个浏览器打开过场页/大厅（如 `firefox`；空=系统默认浏览器）。写可执行文件名或绝对路径，**不绑定任何一家浏览器**
# 例如：firefox
AC_LAUNCHER_BROWSER=

# 启动器强制使用的解释器（排障用；空=自动挑一个装好依赖的解释器）。与部署层的 `AC4_PYTHON` 分开：那个是部署配置，这个是启动器临时指定
AC_LAUNCHER_PYTHON=

# 开机自启的**入口脚本**放哪（默认 `<仓库>/deploy/autostart`）。⚠️ 别放运行数据目录里：换了 `AC_DATA_DIR` 或数据被清，登录自启的入口就凭空消失（登录时什么都不会起）。测试与多实例场景可以指到临时目录
AC_AUTOSTART_DIR=

# AI 后端：`openai`（OpenAI 兼容）/`ollama`/`http_callback`；空=不接 AI
# 例如：openai
AC_AI_PROVIDER=

# 条件必需：AC_AI_PROVIDER=openai 时
# OpenAI 兼容基址（**按你的服务商填**，别照抄示例）
# 例如：https://api.example.com/v1
AC_AI_BASE_URL=

# 条件必需：AC_AI_PROVIDER=openai（或需要鉴权的服务）时
# AI 服务密钥（**绝不入库**；本地配置里保存时：**Windows 走 DPAPI 加密**（绑定当前用户），其它系统**明文**保存并**打告警**提示改用本环境变量）
# 例如：sk-your-key
AC_AI_API_KEY=

# 模型名
# 例如：example-model-flash
AC_AI_MODEL=

# 平台用哪个 Python 解释器去跑脚本/桥（默认当前解释器）
# 例如：/usr/bin/python3
AC_PYTHON=

# 条件必需：手工跑 ACP 类桥且平台未注入时
# ACP 拉起命令（桥用它拉起 agent）
AC_ACP_COMMAND=

# 条件必需：平台为该 harness 启用了 Agent-Token 时
# Agent-Token（桥回报鉴权；平台注册时签发，通常由平台注入）
AC_AGENT_TOKEN=

# ── 功能开关 ────────────────────────────────────────
# 双击启动器时**不要**顺带拉起看门狗（默认 0＝顺带拉起：崩了能自动拉回）。排障或只想手动起一次时设 1
# 例如：1
AC_LAUNCHER_NO_WATCHDOG=0

# 收件目录监视间隔（秒，默认 20）：成员把产物文件放进收件目录（档案 `artifact_inbox_dir` 或默认 `<工位>/产物/`），平台每这么久扫一轮，发现新增/内容变化就发事件并写进组长的 `_lead/_notice.md`。**0＝关掉后台扫描**（仍可手动 `POST …/scan-inbox`）
# 例如：60
AC_ARTIFACT_WATCH_SEC=20

# 状态快照（`data/backups/`）多久拍一份，默认 30 分钟；**0＝关掉自动快照**。快照是 `data/*.json` 的字节复制，恢复用 `tools/state_restore.py`
# 例如：10
AC_STATE_BACKUP_MINUTES=30

# 状态快照保留最近多少份（默认 20；超出的删最旧的）
# 例如：50
AC_STATE_BACKUP_KEEP=20

# 思考强度：off/low/medium/high/max（默认 off 省钱）
AC_AI_REASONING_EFFORT=off

# 相同输入复用历史回复（L2 缓存，零 token）
AC_AI_CACHE_ENABLED=1

# 缓存有效期（秒）
AC_AI_CACHE_TTL=1800

# 缓存容量上限（LRU）
AC_AI_CACHE_MAX=512

# 缓存落盘目录（默认随 AC_DATA_DIR）
AC_AI_CACHE_DIR=

# 用量/预算统计开关
AC_AI_USAGE_ENABLED=1

# SMTP 端口
# 例如：465
AC_SMTP_PORT=587

# 发件地址
# 例如：ops@example.com
AC_SMTP_FROM=

# 收件地址（可逗号分隔）
# 例如：me@example.com
AC_SMTP_TO=

# SMTP 是否 STARTTLS（默认 1）
# 例如：0
AC_SMTP_TLS=1

# 允许平台执行安装命令（默认关；开了也只执行清单里的命令）
# 例如：1
AC_AGENT_INSTALL_ALLOW=0

# 安装命令超时秒数
# 例如：900
AC_AGENT_INSTALL_TIMEOUT=600

# 自定义 agent 清单 JSON 路径（换机器不用改代码）
# 例如：D:/ac/agents.json
AC_AGENT_CATALOG_EXTRA=

# 工作流一次最多并行推进几个节点
# 例如：1
AC_WORKFLOW_BATCH=3

# 同一数据目录已有实例时的行为：fail_closed（拒起，默认）或 degraded（起但标记降级）
# 例如：degraded
AC_SINGLETON_UNAVAILABLE=fail_closed

# 回话探针结果多少小时算过期（超时后 capability 显示 stale）
# 例如：72
AC_PROBE_STALENESS_HOURS=24

# 每个任务保留多少条运行快照（超了丢最旧并留一条截断记录）
# 例如：500
AC_SNAPSHOT_MAX=200

# MCP 挂载哪些工具组（逗号分隔：api/task/bridge/browser/devices/plan；all=全量）
# 例如：api
AC_MCP_TOOLSETS=api,task

# MCP 只读资源单次返回的字节上限（超了先翻页、再截断并标注）；最小 1024
# 例如：131072
AC_MCP_RESOURCE_MAX_BYTES=65536

# 更新源列表（逗号分隔，`名字=地址` 或只写地址）；不配则用本仓库 git 远端
# 例如：gitee=https://gitee.com/<org>/<repo>.git,mirror=https://…
AC_UPDATE_SOURCES=

# 回话探针总开关（默认关；设 1 才允许发探针，避免无意义开销）
# 例如：1
AC_REPLY_PROBE_ENABLED=0

# 回话探针等回执的超时秒数
# 例如：60
AC_REPLY_PROBE_TIMEOUT=120

# 监控室同时看几路画面（默认 6；越多越吃 CPU）
# 例如：4
AC_MONITOR_MAX_WATCH=6

# 监控画面刷新帧率上限（默认 1；快照墙够用，调高更吃 CPU）
# 例如：2
AC_MONITOR_FPS=1

# 派活时**顺手**把这句话用统一投递层送到对方界面（默认关：往别人界面打字有副作用）；开了也不影响派发结果
# 例如：1
AC_DELIVERY_NOTIFY=0

# 浏览器级投递（不用真鼠标）要连的 Chromium 调试端口，可逗号分隔多个：目标应用需自己带 --remote-debugging-port 启动（Electron/Trae 这类）
# 例如：9222
AC_CDP_PORT=9222,9223,9224,9225

# 单条连续画面流的**硬上限**（秒，默认 600）：到点主动收尾，浏览器会自动重连，免得僵尸连接占线程
# 例如：120
AC_MONITOR_STREAM_MAX_SECONDS=600

# 监控的「agent 简单观察」总开关（默认关；开了才允许把变化统计交给 AI 说一句话）
# 例如：1
AC_MONITOR_AI_OBSERVE=0

# AI 观察的最小间隔（分钟，默认 30）——**绝不是每帧一次**
# 例如：60
AC_MONITOR_AI_INTERVAL_MIN=30

# 用量落盘目录（默认随 AC_DATA_DIR）
AC_AI_USAGE_DIR=

# 日预算（元）；超限熔断 AI 调用
AC_BUDGET_DAILY=2.0

# 月预算（元）
AC_BUDGET_MONTHLY=20.0

# 单价（元/1K tokens）；0=只计数不估费
AC_AI_PRICE_PER_1K=0.0

# 条件必需：AC_AI_PROVIDER=http_callback 时
# http_callback 模式的回调地址
AC_HTTP_CALLBACK_URL=

# Ollama 地址
AC_OLLAMA_HOST=http://127.0.0.1:11434

# Ollama 模型名
AC_OLLAMA_MODEL=

# 本地模型自动拉起（1/0）
AC_LOCAL_AI_AUTOSTART=1

# 本地模型快等多长（秒）
AC_LOCAL_AI_QUICK_WAIT=12

# 本地模型冷启等待（秒）
AC_LOCAL_AI_BOOT_WAIT=90

# 掉线自动扫描抢救（**默认关**）
AC_OFFLINE_AUTO=0

# CDP 镜像（调试用）
AC_CDP_MIRROR_ENABLED=0

# 本平台对外基址（A2A/gRPC/MCP 回连平台用）
AC4_BASE_URL=http://127.0.0.1:<AC_PORT>

# A2A 服务端口
AC4_A2A_PORT=9104

# gRPC 网关端口
AC4_GRPC_PORT=9105

# A2A 接力插件开关（默认关）
AC4_A2A_RELAY=0

# 接力信箱目录
AC4_RELAY_INBOX=

# 条件必需：要用 A2A 客户端连对端时
# 对端平台地址（公司间协作用）
AC4_PEER_URL=

# 条件必需：设了 AC4_PEER_URL 时
# 本/对端公司标识
AC4_COMPANY_ID=

# 条件必需：设了 AC4_PEER_URL 时
# 公司级令牌
AC4_COMPANY_TOKEN=

# 条件必需：要生成 frpc 配置把本实例映射到公网时
# frps 地址（公司 B 要被公司 A 访问时才需要）
# 例如：frp.example.com
AC_FRP_SERVER_ADDR=

# frps 控制端口
AC_FRP_SERVER_PORT=7000

# 条件必需：要生成 frpc 配置时
# frps 的 token（**绝不入库**，与服务器侧同一串）
# 例如：your-frp-token
AC_FRP_TOKEN=

# 条件必需：要生成 frpc 配置时
# frps 上对外开放的端口（公司 A 就访问它）
# 例如：19030
AC_FRP_REMOTE_PORT=

# frpc 代理名（同一 frps 上区分多个实例）
AC_FRP_PROXY_NAME=ac-company-b

# 对外任务回执自动收回开关（**默认关**；=1 才开）
# 例如：1
AC_PEER_POLL_ENABLED=0

# 自动收回间隔（秒，最小 10）
AC_PEER_POLL_INTERVAL=60

# 每轮最多查几条回执（1~20）
AC_PEER_POLL_MAX=3

# 条件必需：要跨终端/跨公司协作时
# 中转服务器地址（**终端只出站连它**；空=不启用中转，本机功能照常）
# 例如：http://hub.example.com:9400
AC_HUB_URL=

# 条件必需：设了 AC_HUB_URL 时
# 本终端在中转里的名字（自己起，如 home-desktop；**空=不启用中转**）
# 例如：home-desktop
AC_HUB_TERMINAL_ID=

# 本终端显示名（可选，默认同 ID）
AC_HUB_TERMINAL_NAME=

# 中转共享密钥（**终端与 Hub 用同一个；绝不入库**）
# 例如：your-hub-token
AC_HUB_TOKEN=

# 本终端所属公司（V68；空=default）。只在**共享中转**下参与隔离判断
# 例如：示例公司A
AC_HUB_COMPANY=

# 中转形态：=1 共享（按公司隔离）／默认私有（所有终端互通）
AC_HUB_SHARED=0

# 共享中转下是否允许跨公司（=1 允许；每条消息还要显式带 allow_cross）
AC_HUB_ALLOW_CROSS=0

# 本机收件箱最多保留几条（默认 200）
AC_HUB_INBOX_MAX=200

# Hub 监听端口（跑中转的那台机器用）
AC_HUB_PORT=9400

# Hub 监听地址（跑中转的那台机器用）
AC_HUB_HOST=0.0.0.0

# Hub 每个终端队列上限（超了按最旧丢）
AC_HUB_QUEUE_MAX=200

# ACP 命令的工作目录
AC_ACP_CWD=

# ACP 仓库根（部分 harness 需要）
AC_ACP_REPO=

# ── 开发/测试内部（一般不用管） ────────────────────────────────────────
# **兼容口子（默认 0）**：v4 的自由发言讨论区已被结构化讨论（AILP 2.0）取代。只有设 1 才允许 `POST /api/workshop/{id}/discuss` 走旧逻辑（响应里会标 `legacy: true`）；新前端/新客户一律用 `POST /api/workshop/{id}/ailp`（四类结构化消息）
# 例如：1
AC_ALLOW_LEGACY_DISCUSS=0

# **兼容口子（默认 0）**：`POST /api/workshop/{id}/select-members`（让平台 AI 选人）已于 2026-10-31 退役 —— 平台不选人（`V116` §16），名单由组长回执交回（§8.1）。置 1 可临时恢复旧行为（响应会标 `legacy`）。
# 例如：1
AC_ALLOW_LEGACY_AI_SELECT=0

# **默认 0（关）**：平台**内部 AI 代成员发言**的应急能力。历史上用于「平台 AI 额度挂掉时由外部 AI 接管」：成员被派发后 90 秒无回报、或派发本身失败时，平台会用内部模型冒充该成员在讨论区发言（消息标 `source=manual-sim`）。**这与 `V116` §16「不做：代成员说话」冲突，所以默认关**；只有在 `ai_mode=manual/off` **且**显式置 1 时才会发生。要它请明确知道自己在花谁的钱。
# 例如：1
AC_ALLOW_MANUAL_SIM=0

# **故意清库**的专用口子（默认 0）：只有设 1 才允许「没加载过状态的进程」用空内存覆盖已有数据。正常运行时**不要**开——它是 2026-10-23 数据被清事故的防线
# 例如：1
AC_STATE_ALLOW_EMPTY=0

# 接入自检时**不**自动起桥（测试/排障用）
AC_VERIFY_NO_START_BRIDGE=

# 假回复（离线跑测试用；**生产别设**）
AC_FAKE_REPLY=

# 安全回归指向的地址（测试用）
AC_REGRESSION_BASE=

# 动作脚本上下文标记（平台注入）
AC_ACTION=

# 动作脚本上下文：harness 标识（平台注入）
AC_HARNESS_ID=

# 临时目录（系统自带；Windows 下平台会读它）
TEMP=

# 当前用户名（系统自带；仅在探测/显示里用到）
USERNAME=

# **兼容用**：旧版示例桥读它；新配置请用 AC_AI_API_KEY
DEEPSEEK_API_KEY=
